include mixins/team.pug

doctype html
html(lang=lang)

    head

        -
            const siteUrl = 'https://revivepilatesbkk.com'
            // '/' and '/en' render identical English content; canonical
            // points '/' at '/en' so ranking signals aren't split across
            // duplicate pages (same pattern the old homepage template used).
            const canonicalPath = routePath === '/' ? '/en' : routePath
            const canonicalUrl = siteUrl + canonicalPath
            const enUrl = siteUrl + '/en'
            const thUrl = siteUrl + '/th'
            const ogImage = siteUrl + '/assets/img/portfolio/P1034054.jpg'
            const lineId = contact.line.startsWith('@') ? contact.line.slice(1) : contact.line
            const instaId = contact.instagram.startsWith('@') ? contact.instagram.slice(1) : contact.instagram
            const lineHref = `https://line.me/R/ti/p/%40${lineId}`
            const instaHref = `https://www.instagram.com/${instaId}`
            const telHref = `tel:${contact.phone.replace(/[^\d+]/g, '')}`
            const schema = {
                '@context': 'https://schema.org',
                '@type': 'HealthAndBeautyBusiness',
                name: 'Revive Pilates Bangkok',
                url: canonicalUrl,
                image: ogImage,
                telephone: contact.phone,
                email: contact.email,
                address: {
                    '@type': 'PostalAddress',
                    streetAddress: '2nd Floor, Cove Hill Project, 1888 Charoen Krung Road',
                    addressLocality: 'Bangkok',
                    postalCode: '10120',
                    addressCountry: 'TH'
                },
                geo: {
                    '@type': 'GeoCoordinates',
                    latitude: 13.7100002,
                    longitude: 100.510921
                },
                sameAs: [contact.facebook, instaHref, lineHref],
                description: landing.meta.description
            }

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content=landing.meta.description)

        title= landing.meta.title

        // Canonical + language alternates — this landing page is a separate
        // conversion destination from the homepage, so it gets its own
        // canonical/hreflang pair rather than pointing back at '/en'/'/th'.
        link(rel='canonical', href=canonicalUrl)
        link(rel='alternate', hreflang='en', href=enUrl)
        link(rel='alternate', hreflang='th', href=thUrl)
        link(rel='alternate', hreflang='x-default', href=enUrl)

        // Open Graph / social sharing
        meta(property='og:type', content='website')
        meta(property='og:site_name', content='Revive Pilates Bangkok')
        meta(property='og:title', content=landing.meta.title)
        meta(property='og:description', content=landing.meta.description)
        meta(property='og:url', content=canonicalUrl)
        meta(property='og:image', content=ogImage)
        meta(property='og:locale', content=landing.meta.ogLocale)
        meta(name='twitter:card', content='summary_large_image')
        meta(name='twitter:title', content=landing.meta.title)
        meta(name='twitter:description', content=landing.meta.description)
        meta(name='twitter:image', content=ogImage)

        // LocalBusiness structured data — same business entity as the homepage,
        // scoped to this page's own URL/description per Google's guidance for
        // multiple pages describing one LocalBusiness.
        script(type='application/ld+json')!= JSON.stringify(schema)

        // Google Search Console ownership verification. No-op until
        // src/data/site.json has a gscVerification value.
        if site.gscVerification
            meta(name='google-site-verification', content=site.gscVerification)

        // Google Analytics 4. No-op until src/data/site.json has a
        // gaMeasurementId value — safe to ship as-is before that exists.
        if site.gaMeasurementId
            script(async, src=`https://www.googletagmanager.com/gtag/js?id=${site.gaMeasurementId}`)
            script.
                window.dataLayer = window.dataLayer || [];
                function gtag(){dataLayer.push(arguments);}
                gtag('js', new Date());
                gtag('config', '#{site.gaMeasurementId}');

        // Favicon
        link(rel='icon', type='image/x-icon', href='/assets/favicon.ico')

        // Font Awesome icons (free version)
        script(src='https://use.fontawesome.com/releases/v6.3.0/js/all.js', crossorigin='anonymous', defer)

        // Google fonts
        link(href='https://fonts.googleapis.com/css?family=Montserrat:400,700', rel='stylesheet', type='text/css')
        link(href='https://fonts.googleapis.com/css?family=Roboto+Slab:400,100,300,700', rel='stylesheet', type='text/css')

        // Core theme CSS (includes Bootstrap)
        link(href='/css/styles.css', rel='stylesheet')

    body#page-top.trial-page

        // Full nav — this template became the homepage (previously the
        // /trial ads-landing page; see build-pug.js), so every section on
        // the page gets a jump link instead of the trimmed ads-only menu.
        nav#mainNav.navbar.navbar-expand-lg.navbar-dark.fixed-top
            .container
                a.navbar-brand.trial-nav-brand(href='#page-top')
                    img(src='/assets/img/logo-nav.png', alt='Revive Pilates Bangkok')
                button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarResponsive', aria-controls='navbarResponsive', aria-expanded='false', aria-label='Toggle navigation')
                    | Menu
                    i.fas.fa-bars.ms-1
                #navbarResponsive.collapse.navbar-collapse
                    ul.navbar-nav.text-uppercase.ms-auto.py-4.py-lg-0
                        li.nav-item
                            a.nav-link(href='#services') Services
                        li.nav-item
                            a.nav-link(href='#portfolio') Galleries
                        li.nav-item
                            a.nav-link(href='#team') Team
                        li.nav-item
                            a.nav-link(href='#location') Contact
                        li.nav-item
                            a.nav-link(href='#faq') FAQ
                        li.nav-item.ms-lg-3.mt-2.mt-lg-0
                            .btn-group(role='group')
                                a.btn.btn-sm(
                                    href='/en',
                                    class=lang === 'en' ? 'btn-primary' : 'btn-outline-primary',
                                    role='button'
                                ) EN
                                a.btn.btn-sm(
                                    href='/th',
                                    class=lang === 'th' ? 'btn-primary' : 'btn-outline-primary',
                                    role='button'
                                ) TH
                        li.nav-item.ms-lg-2.mt-2.mt-lg-0
                            a.btn.btn-sm.btn-outline-light(href=telHref, aria-label=`Call ${contact.phone}`, data-gtag-event='call_click', data-gtag-location='nav')
                                i.fas.fa-phone.me-1
                                span.d-lg-none= contact.phone
                        li.nav-item.ms-lg-2.mt-2.mt-lg-0
                            a.btn.btn-sm.btn-success(href=lineHref, target='_blank', aria-label='Chat with Revive Pilates Bangkok on LINE', data-gtag-event='contact_click', data-gtag-location='nav')
                                i.fab.fa-line.me-1
                                | LINE

        // Hero
        header.trial-hero
            .container
                .trial-hero-inner
                    p.trial-eyebrow= landing.hero.eyebrow
                    h1.trial-heading= landing.hero.h1
                    p.trial-subheading= landing.hero.sub
                    .mt-4
                        a.btn.btn-primary.btn-xl.text-uppercase.me-2.mb-2(href=lineHref, target='_blank', data-gtag-event='contact_click', data-gtag-location='hero')= landing.hero.ctaPrimary
                        a.btn.btn-outline-light.btn-xl.text-uppercase.mb-2(href=telHref, data-gtag-event='call_click', data-gtag-location='hero')= landing.hero.ctaSecondary

        // Benefits
        section#benefits.page-section
            .container
                .text-center
                    h2.section-heading.text-uppercase Why Try Revive
                .row.text-center
                    each benefit in landing.benefits
                        .col-md-4
                            span.fa-stack.fa-4x
                                i.fas.fa-circle.fa-stack-2x.text-primary
                                i.fas.fa-stack-1x.fa-inverse(class=`fa-${benefit.icon}`)
                            h4.my-3= benefit.title
                            p.text-muted= benefit.desc

        // Services
        section#services.page-section.bg-light
            .container
                .text-center
                    h2.section-heading.text-uppercase Services
                .row.text-center
                    each service in services
                        .col-md-3
                            span.fa-stack.fa-4x
                                i.fas.fa-circle.fa-stack-2x.text-primary
                                i.fa-stack-1x.fa-inverse(class=`fas fa-${service.icon}`)
                            h4.my-3= service.title
                            p.text-muted= service.desc

        // Galleries
        section#portfolio.page-section
            .container
                .text-center
                    h2.section-heading.text-uppercase Galleries
                .row
                    each photo, i in portfolio
                        .col-lg-4.col-sm-6.mb-4
                            .portfolio-item
                                a.portfolio-link(href=`/assets/img/portfolio/${photo.file}`, target='_blank', title='Open full image in new tab')
                                    .portfolio-hover
                                        .portfolio-hover-content
                                            | Click or hover to enlarge
                                    img.img-fluid(src=`/assets/img/portfolio/${photo.file}`, alt=photo.alt)

        // How it works
        section#how-it-works.page-section.bg-light
            .container
                .text-center
                    h2.section-heading.text-uppercase How It Works
                .row
                    each step in landing.steps
                        .col-md-4.mb-4
                            .trial-step
                                .trial-step-num= step.num
                                h4.my-3= step.title
                                p.text-muted= step.desc

        // Trial offer callout
        section#offer.page-section
            .container
                .trial-offer-box.mx-auto
                    h3.text-uppercase= landing.offer.title
                    p.trial-offer-desc= landing.offer.desc
                    p.trial-offer-note= landing.offer.note
                    a.btn.btn-primary.btn-xl.text-uppercase(href=lineHref, target='_blank', data-gtag-event='contact_click', data-gtag-location='offer')= landing.offer.cta

        // Credibility strip — no photo here: the Team section right below
        // already shows every instructor by name, so a single generic
        // headshot here just duplicated whoever's photo was first in Team.
        section#credibility.page-section.bg-light
            .container.text-center
                p.lead= landing.credibility.text

        // Team
        section#team.page-section
            .container
                .text-center
                    h2.section-heading.text-uppercase Our Amazing Team
                +teamFull(team)

        // Location
        section#location.page-section.bg-light
            .container
                .text-center
                    h2.section-heading.text-uppercase= landing.location.heading
                    h3.section-subheading.text-muted= landing.location.sub
                .map-container.mt-4
                    iframe(src="https://maps.google.com/maps?q=13.7100002,100.510921&z=17&output=embed" allowfullscreen="" loading="lazy")
                .text-center.mt-3
                    a.btn.btn-outline-primary(href="https://maps.app.goo.gl/5q3XJ1TuYEyQ6L9R8", target="_blank", data-gtag-event='directions_click', data-gtag-location='location') Open in Google Maps
                    if contact.address
                        p.mt-3= contact.address

        // FAQ
        section#faq.page-section
            .container
                .text-center
                    h2.section-heading.text-uppercase Frequently Asked Questions
                .trial-faq.mx-auto
                    each item in landing.faq
                        .trial-faq-item
                            h4.trial-faq-q= item.q
                            p.text-muted= item.a

        // Repeated CTA band
        section.trial-cta-band
            .container.text-center
                h3.trial-cta-heading= landing.ctaBand.heading
                a.btn.btn-primary.btn-xl.text-uppercase.mt-3(href=lineHref, target='_blank', data-gtag-event='contact_click', data-gtag-location='cta_band')= landing.ctaBand.cta

        // Footer
        footer.footer.py-4
            .container
                .row.align-items-center
                    .col-lg-6.text-lg-start
                        | Copyright &copy; Revive Pilates Bangkok 2026
                    .col-lg-6.text-lg-end
                        a.btn.btn-dark.btn-social.mx-2(href=lineHref, aria-label='Line', target='_blank', data-gtag-event='contact_click', data-gtag-location='footer')
                            i.fab.fa-line
                        a.btn.btn-dark.btn-social.mx-2(href=contact.facebook, aria-label='Facebook', target='_blank')
                            i.fab.fa-facebook-f
                        a.btn.btn-dark.btn-social.mx-2(href=instaHref, aria-label='Instagram', target='_blank')
                            i.fab.fa-instagram

        // Bootstrap core JS
        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')

        // Core theme JS
        script(src='/js/scripts.js')
