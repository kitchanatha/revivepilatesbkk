doctype html
html(lang=lang)

    head

        -
            const siteUrl = 'https://revivepilatesbkk.com'
            const canonicalPath = routePath === '/' ? '/en' : routePath
            const canonicalUrl = siteUrl + canonicalPath
            const enUrl = siteUrl + '/en'
            const thUrl = siteUrl + '/th'
            const ogImage = siteUrl + '/assets/img/header-bg.jpg'
            const lineId = contact.line.startsWith('@') ? contact.line.slice(1) : contact.line
            const instaId = contact.instagram.startsWith('@') ? contact.instagram.slice(1) : contact.instagram
            const lineHref = `https://line.me/R/ti/p/%40${lineId}`
            const instaHref = `https://www.instagram.com/${instaId}`
            const telHref = `tel:${contact.phone.replace(/[^\d+]/g, '')}`
            const schema = {
                '@context': 'https://schema.org',
                '@type': 'HealthAndBeautyBusiness',
                name: 'Revive Pilates Bangkok',
                url: canonicalUrl,
                image: ogImage,
                telephone: contact.phone,
                email: contact.email,
                address: {
                    '@type': 'PostalAddress',
                    streetAddress: '2nd Floor, Cove Hill Project, 1888 Charoen Krung Road',
                    addressLocality: 'Bangkok',
                    postalCode: '10120',
                    addressCountry: 'TH'
                },
                geo: {
                    '@type': 'GeoCoordinates',
                    latitude: 13.7100002,
                    longitude: 100.510921
                },
                sameAs: [contact.facebook, instaHref, lineHref],
                description: meta.description
            }

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content=meta.description)

        title= meta.title

        // Canonical + language alternates
        // NOTE: '/' and '/en' currently render identical English content (see scripts/build-pug.js).
        // Canonical points '/' at '/en' so ranking signals aren't split across duplicate pages.
        link(rel='canonical', href=canonicalUrl)
        link(rel='alternate', hreflang='en', href=enUrl)
        link(rel='alternate', hreflang='th', href=thUrl)
        link(rel='alternate', hreflang='x-default', href=enUrl)

        // Open Graph / social sharing
        meta(property='og:type', content='website')
        meta(property='og:site_name', content='Revive Pilates Bangkok')
        meta(property='og:title', content=meta.title)
        meta(property='og:description', content=meta.description)
        meta(property='og:url', content=canonicalUrl)
        meta(property='og:image', content=ogImage)
        meta(property='og:locale', content=meta.ogLocale)
        meta(name='twitter:card', content='summary_large_image')
        meta(name='twitter:title', content=meta.title)
        meta(name='twitter:description', content=meta.description)
        meta(name='twitter:image', content=ogImage)

        // LocalBusiness structured data.
        // Intentionally omits openingHours (not yet confirmed) and aggregateRating (no reviews yet) —
        // do not add either until the studio confirms real hours / has genuine reviews to report.
        script(type='application/ld+json')!= JSON.stringify(schema)

        // TODO: Google Search Console verification tag goes here once generated, e.g.
        // meta(name='google-site-verification', content='REPLACE_ME')
        // TODO: GA4 goes here once a measurement ID exists, e.g.
        // script(async, src='https://www.googletagmanager.com/gtag/js?id=G-REPLACE_ME')

        // Favicon
        link(rel='icon', type='image/x-icon', href='/assets/favicon.ico')

        // Font Awesome icons (free version)
        script(src='https://use.fontawesome.com/releases/v6.3.0/js/all.js', crossorigin='anonymous')

        // Google fonts
        link(href='https://fonts.googleapis.com/css?family=Montserrat:400,700', rel='stylesheet', type='text/css')
        link(href='https://fonts.googleapis.com/css?family=Roboto+Slab:400,100,300,700', rel='stylesheet', type='text/css')

        // Core theme CSS (includes Bootstrap)
        link(href='/css/styles.css', rel='stylesheet')

    body#page-top

        // Navigation
        nav#mainNav.navbar.navbar-expand-lg.navbar-dark.fixed-top
            .container
                a.navbar-brand(href='#page-top') Revive Pilates Bangkok
                button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarResponsive', aria-controls='navbarResponsive', aria-expanded='false', aria-label='Toggle navigation')
                    | Menu
                    i.fas.fa-bars.ms-1
                #navbarResponsive.collapse.navbar-collapse
                    ul.navbar-nav.text-uppercase.ms-auto.py-4.py-lg-0
                        li.nav-item
                            a.nav-link(href='#services') Services
                        li.nav-item
                            a.nav-link(href='#portfolio') Galleries
                        li.nav-item
                            a.nav-link(href='#about') About
                        li.nav-item
                            a.nav-link(href='#team') Team
                        li.nav-item
                            a.nav-link(href='#contact') Contact
                        li.nav-item.ms-lg-3.mt-2.mt-lg-0
                            .btn-group(role='group')
                                a.btn.btn-sm(
                                    href='/en',
                                    class=lang === 'en' ? 'btn-primary' : 'btn-outline-primary',
                                    role='button'
                                ) EN
                                a.btn.btn-sm(
                                    href='/th',
                                    class=lang === 'th' ? 'btn-primary' : 'btn-outline-primary',
                                    role='button'
                                ) TH
                        // Always-visible quick contact — deliberately outside the
                        // language switcher group so it keeps its own tap targets.
                        li.nav-item.ms-lg-2.mt-2.mt-lg-0
                            a.btn.btn-sm.btn-outline-light(href=telHref, aria-label=`Call ${contact.phone}`)
                                i.fas.fa-phone.me-1
                                span.d-lg-none= contact.phone
                        li.nav-item.ms-lg-2.mt-2.mt-lg-0
                            a.btn.btn-sm.btn-success(href=lineHref, target='_blank', aria-label='Chat with Revive Pilates Bangkok on LINE')
                                i.fab.fa-line.me-1
                                | LINE
        // Masthead
        header.masthead
            .container
                h1.masthead-heading.text-uppercase= hero.h1
                p.masthead-subheading= hero.sub
                .mt-4
                    a.btn.btn-primary.btn-xl.text-uppercase.me-2.mb-2(href=lineHref, target='_blank')= hero.ctaPrimary
                    a.btn.btn-outline-light.btn-xl.text-uppercase.mb-2(href='https://maps.app.goo.gl/5q3XJ1TuYEyQ6L9R8', target='_blank')= hero.ctaSecondary

        // Services
        section#services.page-section
            .container
                .text-center
                    h2.section-heading.text-uppercase Services
                .row.text-center
                    each service in services
                        .col-md-4
                            span.fa-stack.fa-4x
                                i.fas.fa-circle.fa-stack-2x.text-primary
                                i.fas.fa-star.fa-stack-1x.fa-inverse
                            h4.my-3= service.title
                            p.text-muted= service.desc

        // Packages
        if packages && packages.length
            section#packages.page-section.bg-light
                .container
                    .text-center
                        h2.section-heading.text-uppercase Packages
                    .row.text-center
                        each pkg in packages
                            .col-md-4
                                h4.my-3= pkg.title
                                p.text-muted= pkg.desc

        // Portfolio Grid
        section#portfolio.page-section.bg-light
            .container
                .text-center
                    h2.section-heading.text-uppercase Galleries
                .row
                    each photo, i in portfolio
                        .col-lg-4.col-sm-6.mb-4
                            .portfolio-item
                                a.portfolio-link(href=`/assets/img/portfolio/${photo.file}`, target='_blank', title='Open full image in new tab')
                                    .portfolio-hover
                                        .portfolio-hover-content
                                            | Click or hover to enlarge
                                    img.img-fluid(src=`/assets/img/portfolio/${photo.file}`, alt=photo.alt)

        // About
        section#about.page-section
            .container
                .text-center
                    h2.section-heading.text-uppercase About
                    h3.section-subheading.text-muted= about.desc
                    if about && about.vision
                        p.lead.text-center= about.vision
                ul.timeline
                    li
                        .timeline-image
                            img.rounded-circle.img-fluid(src='/assets/img/logo.jpg', alt='Revive Pilates Logo')
                        .timeline-panel
                            .timeline-heading
                                h4 2026
                                h4.subheading Our Humble Beginnings
                    li.timeline-inverted
                        .timeline-image
                            h4
                                | Be Part
                                br
                                | Of Our
                                br
                                | Story!

        // Team
        section#team.page-section.bg-light
            .container
                .text-center
                    h2.section-heading.text-uppercase Our Amazing Team
                .row
                    .col-lg-3
                        .team-member
                            .member-top
                                img.mx-auto.rounded-circle(src='/assets/img/team/bute.jpg', alt='Bute, Physiotherapy & Pilates instructor at Revive Pilates Bangkok')
                                h4 Bute
                                p.text-muted Physiotherapy & Pilates instructor
                                p.text-muted “Small movements, big changes”
                            h5 Educational Background
                            ul
                                li Bachelor of Science in Allied Health Sciences (Physical therapy), Thammasat University
                            h5 Experience & Approach
                            ul
                                li Experience in physiotherapy internships in hospital settings, as well as providing physiotherapy treatment for football players and runners
                                li Skilled in conducting physiotherapy assessments, analyzing body alignment and movement patterns to treat and prevent injuries, using Pilates-based exercise as the primary approach
                    .col-lg-3
                        .team-member
                            .member-top
                                img.mx-auto.rounded-circle(src='/assets/img/team/nam.jpg', alt='Nam, Physiotherapy & Pilates instructor at Revive Pilates Bangkok')
                                h4 Nam
                                p.text-muted Physiotherapy & Pilates instructor
                                p.text-muted “Every Move Builds Your Strength”
                            h5 Educational Background
                            ul
                                li Bachelor of Science in Allied Health Sciences (Physical Therapy), Thammasat University, graduated with First-Class Honors
                            h5 Experience & Approach
                            ul
                                li Practical experience in physical therapy and movement rehabilitation through academic training and clinical internships
                                li Experience managing musculoskeletal pain, movement dysfunctions, athletes and runners for injury prevention and functional movement improvement
                                li Application of physiotherapy principles in Pilates to enhance safe movement, reduce pain, core strength, and improved posture
                    .col-lg-3
                        .team-member
                            .member-top
                                img.mx-auto.rounded-circle(src='/assets/img/team/tonnam.jpg', alt='Tonnam, Physiotherapy & Pilates instructor at Revive Pilates Bangkok')
                                h4 Tonnam
                                p.text-muted Physiotherapy & Pilates instructor
                                p.text-muted “Trust yourself first — you can get better”
                            h5 Educational Background
                            ul
                                li Bachelor of Science in Allied Health Sciences (Physical Therapy), Thammasat University ,graduated with First-Class Honors
                            h5 Experience & Approach
                            ul
                                li Clinical internship experience across hospital and wellness settings
                                li Provided physiotherapy care for football players, runners, and basketball athletes, including serving as a physiotherapist at the 75th Chulalongkorn–Thammasat Traditional Football Match
                                li Skilled in analyzing posture, movement, and functional needs, and applying Pilates-based and physiotherapy principles to design personalized exercise programs that enhance strength, mobility, and overall movement efficiency
                    .col-lg-3
                        .team-member
                            .member-top
                                img.mx-auto.rounded-circle(src='/assets/img/team/tangmo.jpg', alt='Tangmo, Physiotherapy & Pilates instructor at Revive Pilates Bangkok')
                                h4 Tangmo
                                p.text-muted Physiotherapy & Pilates instructor
                                p.text-muted “Functional movement begins with informed instruction”
                            h5 Educational Background
                            ul
                                li Bachelor of Science in Physical Therapy, Rangsit University, graduated with First-Class Honors
                            h5 Experience & Approach
                            ul
                                li Over 7 years of professional experience at Samitivej Srinakarin Hospital in the Physical Therapy Department, specializing in post-operative rehabilitation and prenatal care
                                li Possesses strong expertise in physical therapy and the ability to integrate clinical knowledge into comprehensive Pilates-based exercise programs

        // Contact
        section#contact.page-section
            .container
                .text-center
                    h2.section-heading.text-uppercase Contact Us
                    h3.section-subheading.text-muted Get in touch
                // embedded google map
                .map-container.mt-4
                    // embed via direct coordinates
                    iframe(src="https://maps.google.com/maps?q=13.7100002,100.510921&z=17&output=embed" allowfullscreen="" loading="lazy")
                a.text-white.mt-2.d-inline-block(href="https://maps.app.goo.gl/5q3XJ1TuYEyQ6L9R8", target="_blank") Open in Google Maps
                if contact
                    .row.mt-4
                        .col-lg-12.text-center
                            if contact.address
                                p= contact.address
                            if contact.phone
                                p= contact.phone
                            if contact.email
                                p
                                    a(href=`mailto:${contact.email}`)= contact.email
                            if contact.facebook
                                p.mb-1
                                    a.d-inline-flex.align-items-center.text-white(href=contact.facebook, target="_blank")
                                        i.fab.fa-facebook-f.me-2
                                        | Facebook
                            if contact.line
                                p.mb-1
                                    a.d-inline-flex.align-items-center.text-white(href=lineHref, target="_blank")
                                        i.fab.fa-line.me-2
                                        | #{contact.line}
                            if contact.instagram
                                p.mb-1
                                    a.d-inline-flex.align-items-center.text-white(href=instaHref, target="_blank")
                                        i.fab.fa-instagram.me-2
                                        | #{contact.instagram}

        // Footer
        footer.footer.py-4
            .container
                .row.align-items-center
                    .col-lg-6.text-lg-start
                        | Copyright &copy; Revive Pilates Bangkok 2026
                    .col-lg-6.text-lg-end
                        // line icon
                        a.btn.btn-dark.btn-social.mx-2(href=lineHref, aria-label='Line', target='_blank')
                            i.fab.fa-line
                        // facebook icon
                        a.btn.btn-dark.btn-social.mx-2(href=contact.facebook, aria-label='Facebook', target='_blank')
                            i.fab.fa-facebook-f
                        // instagram icon
                        a.btn.btn-dark.btn-social.mx-2(href=instaHref, aria-label='Instagram', target='_blank')
                            i.fab.fa-instagram

        // Bootstrap core JS
        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')

        // Core theme JS
        script(src='/js/scripts.js')
